<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <item android:id="@+id/state_on" android:state_activated="true">
        <aapt:attr name="android:drawable">
            <vector
                android:width="140dp"
                android:height="140dp"
                android:viewportWidth="100"
                android:viewportHeight="100">
                <path
                    android:pathData="M 50,50 m -42,0 a 42,42 0 1,0 84,0 a 42,42 0 1,0 -84,0"
                    android:strokeWidth="8"
                    android:strokeColor="#FFFFFF"
                    android:fillColor="#00000000" />
                <path
                    android:pathData="M 28,52 L 43,65 M 43,65 L 72,34"
                    android:strokeWidth="8"
                    android:strokeColor="#FFFFFF"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round"
                    android:fillColor="#00000000" />
            </vector>
        </aapt:attr>
    </item>

    <item android:id="@+id/state_off">
        <aapt:attr name="android:drawable">
            <vector
                android:width="140dp"
                android:height="140dp"
                android:viewportWidth="100"
                android:viewportHeight="100">
                <path
                    android:pathData="M 50,50 m -42,0 a 42,42 0 1,0 84,0 a 42,42 0 1,0 -84,0"
                    android:strokeWidth="8"
                    android:strokeColor="#FFFFFF"
                    android:fillColor="#00000000" />
                <path
                    android:pathData="M 35,35 L 65,65 M 65,35 L 35,65"
                    android:strokeWidth="8"
                    android:strokeColor="#FFFFFF"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round"
                    android:fillColor="#00000000" />
            </vector>
        </aapt:attr>
    </item>

    <transition
        android:fromId="@id/state_off"
        android:toId="@id/state_on">
        <aapt:attr name="android:drawable">
            <animated-vector>
                <aapt:attr name="android:drawable">
                    <vector
                        android:width="140dp"
                        android:height="140dp"
                        android:viewportWidth="100"
                        android:viewportHeight="100">
                        <path
                            android:pathData="M 50,50 m -42,0 a 42,42 0 1,0 84,0 a 42,42 0 1,0 -84,0"
                            android:strokeWidth="8"
                            android:strokeColor="#FFFFFF"
                            android:fillColor="#00000000" />
                        <path
                            android:name="icon"
                            android:pathData="M 35,35 L 65,65 M 65,35 L 35,65"
                            android:strokeWidth="8"
                            android:strokeColor="#FFFFFF"
                            android:strokeLineCap="round"
                            android:strokeLineJoin="round"
                            android:fillColor="#00000000" />
                    </vector>
                </aapt:attr>
                <target android:name="icon">
                    <aapt:attr name="android:animation">
                        <objectAnimator
                            android:propertyName="pathData"
                            android:duration="400"
                            android:valueFrom="M 35,35 L 65,65 M 65,35 L 35,65"
                            android:valueTo="M 28,52 L 43,65 M 43,65 L 72,34"
                            android:valueType="pathType"
                            android:interpolator="@android:interpolator/fast_out_slow_in" />
                    </aapt:attr>
                </target>
            </animated-vector>
        </aapt:attr>
    </transition>

    <transition
        android:fromId="@id/state_on"
        android:toId="@id/state_off">
        <aapt:attr name="android:drawable">
            <animated-vector>
                <aapt:attr name="android:drawable">
                    <vector
                        android:width="140dp"
                        android:height="140dp"
                        android:viewportWidth="100"
                        android:viewportHeight="100">
                        <path
                            android:pathData="M 50,50 m -42,0 a 42,42 0 1,0 84,0 a 42,42 0 1,0 -84,0"
                            android:strokeWidth="8"
                            android:strokeColor="#FFFFFF"
                            android:fillColor="#00000000" />
                        <path
                            android:name="icon"
                            android:pathData="M 28,52 L 43,65 M 43,65 L 72,34"
                            android:strokeWidth="8"
                            android:strokeColor="#FFFFFF"
                            android:strokeLineCap="round"
                            android:strokeLineJoin="round"
                            android:fillColor="#00000000" />
                    </vector>
                </aapt:attr>
                <target android:name="icon">
                    <aapt:attr name="android:animation">
                        <objectAnimator
                            android:propertyName="pathData"
                            android:duration="400"
                            android:valueFrom="M 28,52 L 43,65 M 43,65 L 72,34"
                            android:valueTo="M 35,35 L 65,65 M 65,35 L 35,65"
                            android:valueType="pathType"
                            android:interpolator="@android:interpolator/fast_out_slow_in" />
                    </aapt:attr>
                </target>
            </animated-vector>
        </aapt:attr>
    </transition>

</animated-selector>